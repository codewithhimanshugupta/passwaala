{
  "expo": {
    "name": "NearBaz",
    "slug": "passwala-customer",
    "scheme": "passwala",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B7A4B"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "NearBaz",
      "shortName": "NearBaz",
      "description": "Order from your favourite local shops",
      "themeColor": "#0B7A4B",
      "backgroundColor": "#F5F6F8",
      "display": "standalone",
      "orientation": "portrait",
      "scope": "/",
      "startUrl": "/"
    },
    "ios": {
      "bundleIdentifier": "com.passwala.customer",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "NearBaz uses your location to find nearby shops and show live delivery tracking.",
        "NSUserTrackingUsageDescription": "NearBaz does not track you across other apps."
      }
    },
    "android": {
      "package": "com.passwala.customer",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B7A4B"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NearBaz uses your location to find nearby shops and show live delivery tracking."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0B7A4B"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9a8b35b0-3dbf-4674-9af5-cb131dbaa785"
      }
    },
    "owner": "guphim2"
  }
}
