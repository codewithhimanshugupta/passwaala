// ---------------------------------------------------------------------------
// NearBaz — Prisma schema (Phase 0 foundation)
//
// Mirrors the plan's Data Model, Revenue/Ledger, KYC, Referral, and Order
// Exceptions sections. Enums are kept IN SYNC (identical values) with the
// shared TS source of truth at packages/shared/src/enums.ts.
//
// The 8 migration-safe schema rules from the plan are enforced throughout:
//   1. UUID primary keys on every table          -> id String @id @default(uuid())
//   2. createdAt + updatedAt on every table
//   3. Soft-delete (deletedAt nullable), never hard-delete
//   4. Money as integer paise, never floats       -> *Paise Int (₹10 = 1000)
//   5. Enum status fields treated as APPEND-ONLY   -> only add values, never rename/remove
//   6. Snapshot values onto orders                 -> commissionRateSnapshot, price/name snapshots
//   7. Additive-only / expand-then-contract        -> new cols nullable + defaulted
//   8. Proper FKs + join tables; JSONB only for genuinely open-ended data
//
// Multi-tenant by shop (Shop Data Isolation): every shop-owned row carries a
// shopId, indexed (@@index([shopId])) so per-shop scoping stays fast at scale.
// ---------------------------------------------------------------------------

// NOTE (PostGIS): Prisma does not manage PostGIS geometry/geography types
// directly. For now, location is stored as latitude/longitude Decimal columns
// (queryable, human-readable, precise). A hand-written raw SQL migration (run
// AFTER `prisma migrate`) must:
//   1. CREATE EXTENSION IF NOT EXISTS postgis;
//   2. ALTER TABLE "Shop"    ADD COLUMN geog geography(Point, 4326);
//      ALTER TABLE "Address" ADD COLUMN geog geography(Point, 4326);
//   3. Backfill geog from longitude/latitude:
//        UPDATE "Shop" SET geog = ST_SetSRID(ST_MakePoint(longitude, latitude), 4326)::geography;
//   4. CREATE INDEX shop_geog_gist    ON "Shop"    USING GIST (geog);
//      CREATE INDEX address_geog_gist ON "Address" USING GIST (geog);
// This powers the nearby-shop ST_DWithin radius query (Scalability: Geo-indexing)
// without a table scan. Keep latitude/longitude as the source of truth; geog is
// a derived, indexed column maintained by app/trigger on write.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// ===========================================================================
// ENUMS — APPEND-ONLY (schema rule #5). Kept identical to
// packages/shared/src/enums.ts. Never rename/remove a value.
// ===========================================================================

/// Every account role on the platform. Deny-by-default RBAC keys off this.
/// ADMIN/OWNER are never client-assignable (see Security: no public admin signup).
enum UserRole {
  CUSTOMER
  SHOPKEEPER
  RIDER // future — delivery network
  PROVIDER // future — service businesses
  ADMIN
  OWNER
}

/// A shop's business type. MVP builds PRODUCT; SERVICE is a future seam.
enum BusinessType {
  PRODUCT
  SERVICE
}

/// Shop verification lifecycle. Shop stays hidden until APPROVED.
/// DRAFT -> PENDING_REVIEW -> APPROVED | REJECTED, plus SUSPENDED.
enum VerificationStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

/// Order lifecycle status (drives the whole state machine). Accept-before-pay:
/// PLACED -> ACCEPTED -> AWAITING_PAYMENT -> PREPARING -> READY ->
/// OUT_FOR_DELIVERY -> DELIVERED, plus REJECTED, CANCELLED, REFUND_PENDING.
enum OrderStatus {
  PLACED
  QUOTE_PENDING // medical/prescription: shop is building the itemized bill before the customer pays
  ACCEPTED
  AWAITING_PAYMENT
  PREPARING
  READY
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  REJECTED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

/// How the customer pays the shop DIRECTLY (NearBaz is never in the money flow).
enum PaymentMethod {
  UPI_DIRECT
  COD
  /// Cash tendered at the counter for an in-store POS sale (shopkeeper-created,
  /// marked paid immediately). Never used in the delivery/rider flow.
  CASH
}

/// Order fulfillment mode. Pilot = SELF_DELIVERY or SELF_PICKUP (customer
/// collects from the shop); PLATFORM_RIDER is a future seam.
enum DeliveryMode {
  SELF_DELIVERY
  SELF_PICKUP
  PLATFORM_RIDER
}

/// Per-order-item status for item substitution / partial availability.
enum OrderItemStatus {
  FULFILLED
  UNAVAILABLE
}

/// Ledger entry type. Credits (REFERRAL_CREDIT, REFUND_REVERSAL, COD_REMITTANCE)
/// are stored as signed-negative totalPaise so cancelled/refunded orders never
/// bill the shop. APPEND-ONLY (schema rule #5).
enum LedgerEntryType {
  ONBOARDING_FEE
  COMMISSION
  PLATFORM_FEE
  REFERRAL_CREDIT
  REFUND_REVERSAL
  PAYMENT
  COD_REMITTANCE // credit (neg): NearBaz holds COD cash owed to the shop
  RIDER_DELIVERY_FEE // debit (pos): shop owes the delivery fee it collected (passed to rider)
  DISCOUNT_GIVEN // informational (total 0): "you gave ₹X discount"
  SHOP_PAYOUT // debit (pos): NearBaz pays a shop its negative balance toward 0
  AD_SPEND // debit (pos): shop owes CPC ad spend for sponsored placement (day-end billed)
}

/// Rider ledger entry type — mirrors LedgerEntryType for the rider side.
enum RiderLedgerType {
  DELIVERY_EARNING // +earnings: rider earned the delivery fee
  EARNING_PAYOUT // -earnings: NearBaz paid the rider
  COD_COLLECTED // +dues: rider collected COD cash owed onward
  COD_DEPOSIT // -dues: rider deposited COD cash to NearBaz
}

/// Tax invoice lifecycle.
enum TaxInvoiceStatus {
  DRAFT
  ISSUED
}

/// Ledger entry lifecycle. Credit-limit check sums ACCRUED entries.
enum LedgerEntryStatus {
  ACCRUED
  INVOICED
  PAID
}

/// Who cancelled an order/booking (audit + accountability).
enum CancelledBy {
  CUSTOMER
  SHOP
  PROVIDER
  RIDER
  SYSTEM
}

/// Referral lifecycle. PENDING -> QUALIFIED (referee's 1st order DELIVERED) -> REDEEMED.
enum ReferralStatus {
  PENDING
  QUALIFIED
  REDEEMED
}

/// Referral type: referring a new shop, or a new customer.
enum ReferralType {
  SHOP
  CUSTOMER
}

/// Admin onboarding gate — every privileged account is owner-approved
/// (Security: "OWNER sits above ADMIN — admins require owner approval").
enum AdminInviteStatus {
  PENDING_OWNER_APPROVAL
  ACTIVE
}

/// Offer discount type for city-level offer templates.
enum OfferType {
  PERCENT_OFF // value = percent (e.g. 10 = 10% off subtotal)
  FLAT_OFF // value = paise (e.g. 2000 = ₹20 off subtotal)
  FREE_DELIVERY // value = 0; waives delivery fee entirely
}

/// BulkOrder lifecycle — one envelope per multi-shop checkout.
/// PLACED → shops accept → ACCEPTED_ALL → all READY → RIDER_ASSIGNED
/// → PICKING_UP (rider collecting sequentially) → OUT_FOR_DELIVERY
/// → DELIVERED. CANCELLED if the whole run is called off.
enum BulkOrderStatus {
  PLACED
  ACCEPTED_ALL
  READY_ALL
  RIDER_ASSIGNED
  PICKING_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// Sponsored-ad campaign lifecycle. Admin creates ACTIVE; auto-flips EXHAUSTED
/// (budget spent) or EXPIRED (past endAt); admin can PAUSE. Only ACTIVE campaigns
/// pin a shop to the top of discovery. APPEND-ONLY (rule #5).
enum AdCampaignStatus {
  ACTIVE
  PAUSED
  EXHAUSTED
  EXPIRED
}

/// Ad interaction event type. IMPRESSION = a sponsored card was shown; CLICK = a
/// customer tapped it (CPC billed once per campaign+customer per day, at day-end).
enum AdEventType {
  IMPRESSION
  CLICK
}

/// Prescription (medical-store-only) lifecycle. Customer uploads an Rx (SUBMITTED);
/// the shop builds a free-text itemized quote (QUOTED → an Order in QUOTE_PENDING);
/// customer pays online (CONVERTED). Shop may REJECT (out of stock / unreadable).
enum PrescriptionStatus {
  SUBMITTED
  QUOTED
  CONVERTED
  REJECTED
}

// ===========================================================================
// CORE ENTITIES
// ===========================================================================

/// Owner-controlled list of cities NearBaz operates in. A shop can only
/// register in an `enabled` serviceable city; customers outside one see a
/// "not available in your city yet" state. Managed by the OWNER.
model ServiceableCity {
  id                      String  @id @default(uuid())
  name                    String  @unique // canonical city name (matches Shop.city)
  enabled                 Boolean @default(true)
  /// NearBaz's own UPI VPA for collecting shopkeeper dues in this city
  /// (owner-configured in the admin panel). Shopkeepers in this city pay their
  /// dues to this VPA. Null until the owner sets it; never exposed on the public
  /// serviceable-city list (only surfaced to a scoped shopkeeper's ledger).
  collectionUpiVpa        String?
  /// Payee display name shown in the UPI app (e.g. "NearBaz"). Optional.
  collectionUpiName       String?
  /// Maximum delivery radius for orders in this city (metres). Default 15 km.
  deliveryRadiusMeters    Int     @default(15000)
  /// Radius within which a rider must be online for platform delivery to be available.
  riderCheckRadiusMeters  Int     @default(5000)
  /// Per-km delivery fee tiers (JSON). Array of {maxKm, feePaise}. Must be set before riders can go online.
  deliveryTiersJson       String?
  /// If true, platform delivery orders can only be placed when a rider is online nearby.
  requireRiderForDelivery Boolean @default(true)
  /// Extra surcharge per additional shop in a BulkOrder (+₹10 default). Admin-configurable per city.
  multiShopSurchargePaise Int     @default(1000)
  /// Radius (metres) within which nearby shops appear in the bulk-order "Add from nearby shops" panel. Default 1 km.
  bulkShopRadiusMeters    Int     @default(1000)
  /// Minimum order total (paise) for COD. 0 = no minimum (default).
  codMinOrderPaise        Int     @default(0)
  /// Max COD orders a customer can place per 24h. 0 = unlimited.
  codMaxPerDay            Int     @default(2)
  /// Block COD after this many customer-cancelled COD orders within codCancelWindowDays. 0 = disabled.
  codCancelBlockAfter     Int     @default(2)
  /// Rolling window (days) for COD cancel block check.
  codCancelWindowDays     Int     @default(30)
  // Note: no first-order UPI restriction — all customers can use COD from order 1.

  // ── Operational config (all admin-configurable per city) ─────────────────
  /// Minutes before an unanswered PLACED order is auto-cancelled. Default 15.
  autoCancelMinutes       Int @default(15)
  /// Seconds a rider's offer window stays open before it is re-offered. Default 15.
  riderOfferWindowSec     Int @default(15)
  /// Max concurrent active orders a rider can hold. Default 2.
  maxActiveOrdersPerRider Int @default(2)
  /// Minutes before a PLACED order triggers a shop reminder re-emit. Default 5.
  shopReminderMinutes     Int @default(5)
  /// Minutes before a RIDER_ASSIGNED order is released back to READY. Default 20.
  staleRiderMinutes       Int @default(20)
  /// Default search radius (metres) for customer nearby-shops discovery. Default 3000.
  nearbyShopsRadiusMeters Int @default(3000)

  // ── Fee / commission config ───────────────────────────────────────────────
  /// Flat platform fee added to every order (paise). Default ₹10.
  platformFeePaise        Int   @default(1000)
  /// Default commission rate for PRODUCT shops (decimal). Default 0.02 = 2%.
  defaultCommissionRate   Float @default(0.02)
  /// Default credit limit for new shops (paise). Default ₹500.
  defaultCreditLimitPaise Int   @default(50000)
  /// Commission-free days granted when a shop is approved. Default 30.
  commissionHolidayDays   Int   @default(30)
  /// One-time onboarding fee for a PRODUCT shop (paise). Default ₹499.
  onboardingFeePaise      Int   @default(49900)

  // ── Referral / coin config ────────────────────────────────────────────────
  /// Coins awarded to a customer referrer when the referee's first order delivers. Default 25.
  referralCustomerCoins Int @default(25)
  /// Coins awarded to a shop referrer when the referred shop completes its first order. Default 100.
  referralShopCoins     Int @default(100)

  /// Max COD orders per customer per rolling window (hours). Default 24.
  codWindowHours Int @default(24)

  // ── Sponsored-ads config (admin-tunable per city) ─────────────────────────
  /// Cost-per-click (paise) charged to a shop for each unique daily click on its
  /// sponsored card. Snapshotted onto a campaign at opt-in. Default ₹5.
  sponsoredCpcPaise           Int @default(500)
  /// Default total ad budget (paise) suggested when a shop opts into promotion. ₹500.
  sponsoredDefaultBudgetPaise Int @default(50000)

  // ── Ranking config (admin-tunable per city) ───────────────────────────────
  /// Days a newly-approved shop gets a discovery boost. Default 21.
  newShopBoostDays Int @default(21)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  adminInvites   AdminInvite[]
  offerTemplates OfferTemplate[]

  @@index([enabled])
}

/// A platform account. role is server-assigned only (never trusted from client
/// input); ADMIN/OWNER are never created via public signup.
model User {
  id      String   @id @default(uuid())
  /// Human-readable support ID shown to the user (C + 8 hex). Unique, set once.
  shortId String?  @unique
  role    UserRole @default(CUSTOMER)
  phone   String // verified via OTP; unique per appType
  /// Identity namespace — CUSTOMER | SHOPKEEPER | RIDER | ADMIN | OWNER.
  /// Same phone can exist independently in each app.
  appType String   @default("CUSTOMER")
  name    String?

  /// scrypt password hash ("<saltHex>:<hashHex>"), one-way. Null until the user
  /// sets a password (phone+password login; no SMS OTP gateway for the pilot).
  passwordHash String?
  /// scrypt hash of the user-chosen 4-digit login PIN ("<saltHex>:<hashHex>"),
  /// one-way. A real user credential (set + confirmed at signup), distinct from
  /// a one-time SMS OTP. Null until the user sets a PIN.
  pinHash      String?
  /// The 4-digit login PIN, AES-256-GCM encrypted at rest ("iv:tag:cipher") so
  /// admin can reveal it to help a locked-out user (support convenience). Kept
  /// alongside pinHash (which is what login actually verifies). Null until set.
  loginPinEnc  String?
  /// The fixed backup login OTP, AES-256-GCM encrypted at rest ("iv:tag:cipher").
  /// Admin can reveal it (server decrypts) so a locked-out user can be helped.
  loginOtpEnc  String?

  /// NearBaz Coins voucher balance (a discount voucher, NOT real money / not a
  /// wallet — keeps NearBaz clear of RBI PPI regulation). Integer coin count.
  coinBalance            Int     @default(0)
  /// Pending cancel fee from a COD order cancellation — added to next order's total.
  /// Customer cannot place another COD order until this is cleared.
  pendingCancelFeePaise  Int     @default(0)
  /// Which shop gets 50% of the pending cancel fee on delivery of the next order.
  pendingCancelFeeShopId String?

  /// Stable public referral code (derived from id at creation) so this user can
  /// refer others (plan → Referral program). Unique; nullable for legacy rows.
  referralCode String? @unique

  // Relations
  ownedShops        Shop[]             @relation("ShopOwner")
  carts             Cart[]
  orders            Order[]            @relation("OrderCustomer") // as customer
  addresses         Address[]
  reviews           Review[] // reviews written by this customer
  ridDeliveries     Order[]            @relation("OrderRider") // future: orders assigned to this rider
  bulkOrders        BulkOrder[]        @relation("BulkOrderCustomer")
  bulkDeliveries    BulkOrder[]        @relation("BulkOrderRider")
  referralsMade     Referral[]         @relation("Referrer")
  referredAs        Referral[]         @relation("RefereeUser")
  adminInvites      AdminInvite[]      @relation("InvitedByOwner")
  riderProfile      RiderProfile?
  riderKyc          RiderKyc?
  pushSubscriptions PushSubscription[]
  expoPushTokens    ExpoPushToken[]
  prescriptions     Prescription[]     @relation("PrescriptionCustomer")
  customerProfile   CustomerProfile?
  adEvents          AdEvent[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete (rule #3)

  @@unique([phone, appType])
  @@index([role])
}

/// A Web Push subscription for a user's browser/PWA (VAPID). Lets us send order
/// notifications when the app is backgrounded / phone locked. One row per
/// device+browser; endpoint is unique. Cleaned up on 410 Gone from the push service.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String // client public key (from the browser subscription)
  auth      String // client auth secret (from the browser subscription)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// An Expo push token for a user's native app install (iOS/Android). Lets us
/// deliver OS push notifications to the native Customer/Shopkeeper/Rider apps
/// (the web PWAs use PushSubscription/VAPID). One row per device install;
/// token is unique. Pruned on a DeviceNotRegistered receipt from Expo.
model ExpoPushToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // ExponentPushToken[...]
  platform  String? // 'ios' | 'android'
  appType   String? // CUSTOMER | SHOPKEEPER | RIDER
  deviceId  String? // optional client-provided device identifier
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A shop (product business for the MVP). Cannot be discovered/receive orders
/// until verificationStatus = APPROVED.
model Shop {
  id      String  @id @default(uuid())
  /// Human-readable support ID (S + 8 hex). Unique, set once at registration.
  shortId String? @unique
  // Owner
  ownerId String
  owner   User    @relation("ShopOwner", fields: [ownerId], references: [id])

  name               String // shop display name (shown in discovery + storefront)
  businessType       BusinessType       @default(PRODUCT)
  shopCategory       String // kirana / dairy / medical / fruits-veg / electronics / clothing / hardware ...
  verificationStatus VerificationStatus @default(DRAFT)

  // Public profile shown to customers (city is owner-decided; pilot = Jhansi).
  city         String  @default("Jhansi")
  addressLine  String? // shop street address
  contactPhone String? // public contact number

  // Media (Storefront Photo — trust/fraud gate)
  storefrontPhotoUrl String // required — real photo of the physical storefront
  logoUrl            String?
  bannerUrl          String?

  // Direct payment (no gateway — customer pays the shop's own UPI)
  upiVpa String?
  upiQr  String?

  // GST identity (for tax invoices NearBaz issues to the shop). Nullable (rule #7).
  gstin     String? // shop's 15-char GSTIN
  stateCode String? // 2-digit GST state code (derived from GSTIN or set manually)
  legalName String? // registered legal/business name for the invoice

  // Location — Decimal lat/lng now; PostGIS geog(Point)+GIST added by raw migration (see NOTE)
  latitude  Decimal                                @db.Decimal(9, 6)
  longitude Decimal                                @db.Decimal(9, 6)
  /// PostGIS geography(Point,4326), derived from longitude/latitude by the
  /// postgis_geog_columns migration. Declared Unsupported so Prisma STOPS trying
  /// to drop it on every diff; it stays out-of-band (raw SQL + GIST index).
  geog      Unsupported("geography(Point, 4326)")?

  // Revenue / commission config (rule #6: rate is snapshotted onto each Order)
  commissionRate      Float     @default(0.02) // default 2%; per-shop editable by admin
  commissionFreeUntil DateTime? // 1-month commission holiday end (set at approval)

  // Credit limit / ledger enforcement (all money in integer paise, rule #4)
  creditLimitPaise     Int // default ₹500 = 50000 paise (set at creation)
  outstandingDuesPaise Int @default(0) // GST-inclusive dues owed to NearBaz

  // Per-shop cart/checkout economics (paise)
  minOrderValuePaise      Int       @default(0) // enforced on item subtotal, before ₹10 fee
  deliveryFeePaise        Int       @default(0)
  freeDeliveryAbovePaise  Int? // nullable threshold; delivery auto-waived at/above
  // Cancellation fee rate (0.0–0.10 = 0–10%) charged when customer cancels a
  // PREPARING order. 0 means no fee. Capped at 10% platform-wide.
  cancelFeeRatePct        Float     @default(0)
  /// Whether this shop accepts Cash on Delivery. Admin-configurable. Default true.
  codEnabled              Boolean   @default(true)
  /// Shopkeeper's appeal message after rejection/suspension. Cleared on re-approval.
  appealMessage           String?
  appealSubmittedAt       DateTime?
  /// Whether this shop uses the NearBaz rider network. When true, customers may
  /// choose PLATFORM_RIDER and READY orders auto-post to the rider job board.
  platformDeliveryEnabled Boolean   @default(false)
  /// Whether the shop allows customers to pick up their order in person (no delivery fee).
  selfPickupEnabled       Boolean   @default(true)

  /// Optional short promo shown on the customer home card (e.g. "20% OFF on
  /// select items"). Display-only; NearBaz doesn't apply it to the bill.
  offerText String?

  /// Active structured offer template selected by the shopkeeper.
  activeOfferId String?
  activeOffer   OfferTemplate? @relation("ShopActiveOffer", fields: [activeOfferId], references: [id])

  // Availability
  workingHours Json? // per-day open/close schedule for auto open/close (open-ended -> JSONB, rule #8)
  isOpen       Boolean @default(false) // effective/manual open toggle (manual overrides schedule)

  // Denormalized rating (fast indexed sort/filter; updated when a review is written)
  avgRating   Float @default(0)
  ratingCount Int   @default(0)

  // ── Ranking signals (Zomato-style discovery). rankScore is recomputed by a
  // cron (recomputeShopRankScores) from these denormalized inputs; discovery
  // ORDER BY layers distance/open/sponsored/personalization on top at query time.
  rankScore   Float     @default(0) // precomputed composite relevance score (higher = ranks first)
  orderCount  Int       @default(0) // lifetime delivered-order count (popularity input)
  lastOrderAt DateTime? // recency-of-activity input for the score

  // ── Premium (admin-curated). Distinct from paid CPC ads: admin hand-picks
  // "Premium" shops that surface in a dedicated customer-app section. Not billed.
  isPremium Boolean @default(false) // admin toggles; shows in the Premium section

  // Relations
  kyc           ShopKyc?
  categories    Category[]
  products      Product[]
  carts         Cart[]
  orders        Order[]
  reviews       Review[]
  ledger        LedgerEntry[]
  taxInvoices   TaxInvoice[]
  referredBy    Referral[]     @relation("RefereeShop")
  adCampaigns   AdCampaign[]
  adEvents      AdEvent[]
  prescriptions Prescription[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([ownerId])
  @@index([verificationStatus])
  @@index([shopCategory])
  @@index([isOpen])
  @@index([rankScore])
}

/// KYC + document bundle for a shop. ADMIN-ONLY access — never returned on
/// customer/shopkeeper read APIs; docs live in a private bucket (see Security).
model ShopKyc {
  id String @id @default(uuid())

  shopId String @unique // 1:1 with Shop
  shop   Shop   @relation(fields: [shopId], references: [id])

  aadhaarPan   String // owner identity: Aadhaar and/or PAN number (field-encrypt in prod)
  gstOrLicence String // GST number OR shop establishment / Gumasta / trade licence
  fssai        String? // required for food/restaurant shops
  bankProofUrl String // cancelled cheque / passbook image (payee identity)
  docUrls      Json // ADMIN-ONLY: array of stored document image URLs (private bucket)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shopId])
}

/// A shop-scoped product category (Category grid / drill-down).
model Category {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  name String

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shopId])
}

/// A product in a shop's catalogue.
model Product {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  name        String
  pricePaise  Int // selling price (paise, rule #4)
  mrpPaise    Int // MRP for strike-through display
  stock       Int     @default(0)
  imageUrl    String?
  description String? // longer product detail, loaded lazily on the product-detail view
  available   Boolean @default(true) // catalog availability toggle (hide without deleting)
  weightGrams Int? // weight in grams — mandatory for new products, used for multi-rider dispatch

  // Denormalized popularity (per-shop) — incremented on each DELIVERED order.
  orderCount Int @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([shopId])
  @@index([categoryId])
  @@index([shopId, available]) // hot: public catalog listing (shop + in-stock filter)
}

/// A customer's cart. A cart maps to EXACTLY ONE shop (single-shop cart rule).
model Cart {
  id String @id @default(uuid())

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  shopId String // one shop per cart
  shop   Shop   @relation(fields: [shopId], references: [id])

  items CartItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // One active cart per customer per shop (multi-shop cart support)
  @@unique([customerId, shopId])
  @@index([shopId])
}

/// A line in a cart.
model CartItem {
  id String @id @default(uuid())

  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  qty Int @default(1)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([cartId, productId]) // one line per product per cart
  @@index([cartId])
  @@index([productId])
}

/// A BulkOrder envelope spans multiple sub-orders (one per shop). Created at
/// checkout when the customer has carts from more than one shop. The rider
/// picks up from each shop sequentially (nearest-first, sorted at acceptance)
/// and delivers to the customer in a single run.
model BulkOrder {
  id      String  @id @default(uuid())
  /// Human-readable ID: BLK + 8 hex, e.g. BLK-4F2A9C1B
  shortId String? @unique

  customerId String
  customer   User   @relation("BulkOrderCustomer", fields: [customerId], references: [id])

  addressId String
  address   Address @relation(fields: [addressId], references: [id])

  status        BulkOrderStatus @default(PLACED)
  paymentMethod PaymentMethod

  // Financials (paise, rule #4)
  baseDeliveryFeePaise    Int // distance-tiered fee for anchor shop → customer
  multiShopSurchargePaise Int // (shopCount-1) × city surcharge, snapshotted at placement
  platformFeePaise        Int // sum of per-sub-order platform fees
  totalPaise              Int // grand total across all sub-orders

  // Rider assignment
  riderId            String?
  rider              User?   @relation("BulkOrderRider", fields: [riderId], references: [id])
  /// Ordered list of sub-order IDs the rider should visit, nearest-first.
  /// Null until a rider accepts; written at acceptance using rider's live location.
  pickupSequenceJson String? // JSON: string[] of orderId
  /// Customer handoff OTP — single OTP shown in customer app, entered by rider at final delivery.
  pickupOtp          String?

  // Dispatch fields (mirrors Order dispatch for the open-board flow)
  offeredRiderId        String?
  offerExpiresAt        DateTime?
  dispatchTriedRiderIds String[]  @default([])
  dispatchRadiusMeters  Int?
  dispatchExhausted     Boolean   @default(false)

  // Idempotency — client-generated key prevents double-placement.
  idempotencyKey String @unique

  orders Order[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([status])
  @@index([riderId])
}

/// An order. Durable source of truth; idempotencyKey guarantees exactly-once
/// placement. Snapshots commissionRate at order time (rule #6).
model Order {
  id      String  @id @default(uuid())
  /// Human-readable support ID (OR + 8 hex). Unique, set once at placement.
  shortId String? @unique

  customerId String
  customer   User   @relation("OrderCustomer", fields: [customerId], references: [id])

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  status OrderStatus @default(PLACED)

  // Payment (direct customer -> shop; NearBaz records only)
  paymentMethod     PaymentMethod
  paymentConfirmed  Boolean       @default(false) // set by the SHOP when it verifies receipt
  // UPI payment claim handshake: the customer taps "I've paid" (a claim), the
  // shop verifies. paymentClaimedAt is set on each claim and cleared when the
  // shop says "not received" (re-prompting the customer). paymentClaimCount
  // tracks repeat attempts so the shop sees a nagging/failed payment.
  paymentClaimedAt  DateTime?
  paymentClaimCount Int           @default(0)
  // COD-by-QR handshake at the door: for a COD platform-rider order, the rider
  // records that the customer paid the shop's UPI (codUpiClaimedAt); the SHOP
  // then confirms receipt (paymentConfirmed) before the rider can mark it
  // DELIVERED. Cleared if the shop says "not received". Null otherwise.
  codUpiClaimedAt   DateTime?

  // Exception handling
  rejectionReason         String? // shop reject reason (out of stock / closing / too busy / NO_RESPONSE)
  cancelledBy             CancelledBy?
  cancellationReason      String?
  cancelledAt             DateTime?
  /// When the customer confirmed they received their off-platform refund (→ REFUNDED).
  refundConfirmedAt       DateTime?
  // Customer cancellation request (PREPARING orders only — shop must approve/deny)
  cancelRequestedAt       DateTime? // set when customer requests cancel on a PREPARING order
  cancelRequestReason     String? // customer's reason
  cancelFeePaise          Int? // fee the shop may charge (0–10% of total); null until shop responds
  /// One-time nudge text the customer can send to the shop while order is active.
  customerNudge           String?
  customerNudgedAt        DateTime?
  /// Customer confirmed modified order (items removed by shop). Unblocks ACCEPTED → next steps.
  customerAcceptedChanges Boolean      @default(false)
  /// Set when shop marks items unavailable. Used to compute auto-accept countdown for the customer.
  itemsChangedAt          DateTime?

  // Totals (paise, rule #4). adjusted* set when items are marked unavailable.
  originalTotalPaise    Int
  adjustedTotalPaise    Int? // customer-approved reduced total after substitution
  platformFeePaise      Int // flat ₹10 platform fee line = 1000 paise
  deliveryFeePaise      Int     @default(0)
  // Admin-edited extra delivery due: set when admin raises delivery fee on a prepaid
  // (UPI_DIRECT + paymentConfirmed) order so the rider can collect the delta on delivery.
  extraDeliveryDuePaise Int     @default(0)
  // Items added post-placement on a prepaid order: customer already paid the original
  // total, so the delta is collected at the door by the rider/shop.
  addedItemsDuePaise    Int     @default(0)
  // Cancel fee carried over from a previous COD cancellation. Collected via UPI
  // on this order; split 50% shop / 50% NearBaz on DELIVERED.
  cancelFeeLinePaise    Int     @default(0)
  // Which shop gets 50% of cancelFeeLinePaise (the original cancelled order's shop).
  cancelFeeShopId       String?

  // Commission snapshot (rule #6) — future commission edits never rewrite history.
  commissionRateSnapshot Float @default(0.02)

  // Delivery (seam for future rider network)
  deliveryMode DeliveryMode @default(SELF_DELIVERY)
  riderId      String? // nullable — populated once the rider system exists
  rider        User?        @relation("OrderRider", fields: [riderId], references: [id])

  // Multi-rider: when an order's total weight exceeds 20 kg, additional riders
  // can be assigned (by admin or by the primary rider calling support). Each
  // rider handles a ~20 kg share. Stored as a plain array — no join table needed
  // since these are secondary assignments and never drive state transitions.
  additionalRiderIds String[] @default([])

  // Total weight of this order in grams, computed at placement from weightGrams
  // snapshots. Null for legacy orders placed before the weight field was added.
  totalWeightGrams Int?

  // Proximity dispatch (PLATFORM_RIDER): the order is offered to the nearest
  // online rider for a short window; on timeout it re-offers to the next nearest,
  // widening the search ring, until someone accepts or all rings are exhausted
  // (then it opens to any online rider). All null/empty for non-rider orders.
  offeredRiderId        String? // rider currently being offered this order
  offerExpiresAt        DateTime? // when the current offer times out (~15s)
  dispatchTriedRiderIds String[]  @default([]) // riders already offered (skip on re-offer)
  dispatchRadiusMeters  Int? // current search ring (2000 → 5000 → 10000)
  dispatchExhausted     Boolean   @default(false) // all rings tried → open board

  // Handoff OTP: shown in the customer app; the shop (delivery) or the shop at
  // the counter (pickup) enters it to verify the right customer received the
  // order before it's marked DELIVERED. Set on every order.
  pickupOtp String?

  // Rider pickup OTP: shown in the SHOPKEEPER app; the platform rider reads it
  // off the shopkeeper's screen and enters it to confirm collection, moving a
  // PLATFORM_RIDER order RIDER_ASSIGNED -> OUT_FOR_DELIVERY. Distinct from the
  // customer handoff pickupOtp above. Set on every order (only used by riders).
  riderPickupOtp String?

  // NearBaz Coins redeemed on this order (1 coin = ₹1 = 100 paise), discounting
  // the item subtotal. 0 when no coins used. Deducted from the customer balance.
  coinsRedeemedPaise Int @default(0)

  // Offer discount applied at order time (snapshot from shop.activeOffer).
  // discountPaise is deducted from the item subtotal before computing the total.
  discountPaise Int     @default(0)
  offerId       String? // FK to OfferTemplate (for audit; nullable after deletedAt)
  offerTitle    String? // snapshot of offer title at order time

  // NearBaz-funded (platform) coupon discount applied at order time. Distinct from
  // discountPaise: this amount is borne by the NearBaz PLATFORM, never the shop —
  // it is recorded in PlatformLedgerEntry (COUPON_SUBSIDY) and NEVER writes a shop
  // ledger line. 0 when no NearBaz coupon was applied. The shop is still
  // commissioned on the full pre-discount subtotal (added back like discountPaise).
  nearbazDiscountPaise Int @default(0)

  // Coupon applied to this order (shop-funded OR NearBaz-funded). couponId links to
  // the Coupon for usage/audit; couponCode snapshots the code at order time. Null
  // when no coupon was used. A single order carries at most ONE coupon (mutually
  // exclusive with an offer and with a second coupon — enforced server-side).
  couponId    String?
  couponCode  String?

  // Reliability — client-generated key so retries/double-taps never duplicate.
  idempotencyKey String @unique

  // In-store POS (counter) sale: shopkeeper-created walk-in sale, created
  // directly at DELIVERED, paid CASH, commission-free. Distinguishes counter
  // sales from delivery/pickup orders in the feed and future POS reports.
  isPosSale Boolean @default(false)

  // BulkOrder link — null for standalone single-shop orders.
  bulkOrderId String?
  bulkOrder   BulkOrder? @relation(fields: [bulkOrderId], references: [id])

  // Prescription link — set for medical-store prescription orders (the shop-built
  // quote from an uploaded Rx). Null for normal catalog/bulk orders.
  prescriptionId String?       @unique
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])

  // Relations
  items     OrderItem[]
  ledger    LedgerEntry[]
  reviews   Review[]
  addressId String?
  address   Address?      @relation(fields: [addressId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete only — order history is never destroyed

  @@index([shopId])
  @@index([customerId])
  @@index([status])
  @@index([riderId])
  @@index([bulkOrderId])
  @@index([shopId, status]) // hot: shopkeeper order feed (shop + status tab)
  @@index([shopId, isPosSale]) // POS counter-sale reports
}

/// An order line. Carries snapshots (rule #6) + substitution status.
model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // Nullable: prescription (medical-store) orders carry free-text line items the
  // shop types in — they have no catalog Product. nameSnapshot/pricePaiseSnapshot
  // carry the display data for those lines. Catalog orders always set productId.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  nameSnapshot        String // product name at order time (rule #6)
  pricePaiseSnapshot  Int // unit price at order time, paise (rule #6)
  weightGramsSnapshot Int? // weight at order time (rule #6) — null for legacy orders
  qty                 Int             @default(1)
  status              OrderItemStatus @default(FULFILLED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([orderId])
  @@index([productId])
}

/// A customer address with geo coordinates (needed for serviceability + future
/// rider routing). PostGIS geog(Point)+GIST added by raw migration (see NOTE).
model Address {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  line      String // house/flat + street (structured address)
  landmark  String? // often more reliable than coords in India
  latitude  Decimal                                @db.Decimal(9, 6)
  longitude Decimal                                @db.Decimal(9, 6)
  label     String // Home / Work / Other
  /// PostGIS geography(Point,4326), derived from longitude/latitude (see the
  /// postgis_geog_columns migration). Unsupported so Prisma won't drop it.
  geog      Unsupported("geography(Point, 4326)")?

  orders     Order[]
  bulkOrders BulkOrder[]
  prescriptions Prescription[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

/// A shop rating written by a customer, one per delivered order (verified purchase).
model Review {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  rating  Int // 1..5
  comment String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([orderId]) // one review per order (verified purchase)
  @@index([shopId])
  @@index([customerId])
}

// ===========================================================================
// REVENUE / LEDGER
// ===========================================================================

/// A dues/credit line in a shop's ledger. Each DELIVERED order writes two rows
/// (COMMISSION + PLATFORM_FEE). GST (18%) stored as a separate component; the
/// signed totalPaise is what drives outstandingDues + credit-limit checks.
/// Credits (REFERRAL_CREDIT, REFUND_REVERSAL) are stored as NEGATIVE totalPaise.
model LedgerEntry {
  id String @id @default(uuid())

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  orderId String? // nullable — ONBOARDING_FEE / REFERRAL_CREDIT have no order
  order   Order?  @relation(fields: [orderId], references: [id])

  type LedgerEntryType

  // Money components (paise, rule #4). GST-inclusive total used for dues/limit.
  basePaise  Int // base amount before GST
  gstPaise   Int // 18% GST on NearBaz's earnings
  totalPaise Int // SIGNED: base + gst; negative for credits/reversals

  status LedgerEntryStatus @default(ACCRUED)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // never hard-delete — losing a ledger row = losing money owed

  @@index([shopId])
  @@index([orderId])
  @@index([status])
}

/// Rider-side ledger — mirrors LedgerEntry for the rider. The denormalized
/// RiderProfile.earningsPaise/duesPaise stay as running balances; this table is
/// the itemized history + audit trail (esp. for payouts). Never hard-deleted.
model RiderLedger {
  id String @id @default(uuid())

  riderUserId String
  orderId     String? // nullable — payouts/deposits have no single order

  type        RiderLedgerType
  amountPaise Int // SIGNED (earnings/dues delta), rule #4
  note        String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([riderUserId])
  @@index([orderId])
  @@index([type])
}

/// NearBaz's own tax identity + invoice counter (single owner-managed row).
/// Drives the intra/inter-state GST split (compare shop stateCode to stateCode
/// here) and issues sequential tax-invoice numbers.
model PlatformGstConfig {
  id            String   @id @default(uuid())
  legalName     String
  gstin         String
  stateCode     String // NearBaz's home state code — intra-state when shop matches
  address       String?
  invoicePrefix String   @default("PW")
  invoiceSeq    Int      @default(0) // running counter; atomically incremented on issue
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A tax invoice NearBaz issues to a shop (monthly consolidated), for GST
/// filing. taxableValue = COMMISSION + PLATFORM_FEE base; GST split by state.
model TaxInvoice {
  id            String @id @default(uuid())
  invoiceNumber String @unique // e.g. PW-2026-000123

  shopId        String
  shop          Shop    @relation(fields: [shopId], references: [id])
  shopGstin     String?
  shopStateCode String?

  periodStart DateTime
  periodEnd   DateTime

  // All money in integer paise (rule #4).
  taxableValuePaise Int
  cgstPaise         Int @default(0)
  sgstPaise         Int @default(0)
  igstPaise         Int @default(0)
  totalPaise        Int

  status   TaxInvoiceStatus @default(DRAFT)
  issuedAt DateTime?

  lines     TaxInvoiceLine[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  @@index([shopId])
  @@index([status])
}

/// One line of a TaxInvoice (a commission or platform-fee component).
model TaxInvoiceLine {
  id        String     @id @default(uuid())
  invoiceId String
  invoice   TaxInvoice @relation(fields: [invoiceId], references: [id])

  ledgerEntryId     String?
  description       String
  hsnSac            String // SAC code for the service (e.g. 9985 support services)
  taxableValuePaise Int
  gstRate           Float   @default(0.18)
  cgstPaise         Int     @default(0)
  sgstPaise         Int     @default(0)
  igstPaise         Int     @default(0)

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// ===========================================================================
// REFERRAL
// ===========================================================================

/// A referral (NearBaz Coins voucher program). Coins unlock only after the
/// qualifying 1st order is DELIVERED (status QUALIFIED). Funded by NearBaz via
/// a REFERRAL_CREDIT LedgerEntry against the shop's dues at redemption.
model Referral {
  id String @id @default(uuid())

  referrerId String
  referrer   User   @relation("Referrer", fields: [referrerId], references: [id])

  // Exactly one of these is set depending on type.
  refereeUserId String? // referred a new customer
  refereeUser   User?   @relation("RefereeUser", fields: [refereeUserId], references: [id])

  refereeShopId String? // referred a new shop
  refereeShop   Shop?   @relation("RefereeShop", fields: [refereeShopId], references: [id])

  type   ReferralType
  status ReferralStatus @default(PENDING)

  coinReward Int // 100 for a shop referral, 25 for a customer referral

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([referrerId])
  @@index([refereeUserId])
  @@index([refereeShopId])
  @@index([status])
}

// ===========================================================================
// ADMIN GOVERNANCE
// ===========================================================================

/// Owner-gated admin onboarding. No ADMIN self-creates: an invite goes
/// PENDING_OWNER_APPROVAL -> ACTIVE (mirrors how shops need approval).
model AdminInvite {
  id String @id @default(uuid())

  email String?
  phone String?

  invitedByOwnerId String
  invitedByOwner   User   @relation("InvitedByOwner", fields: [invitedByOwnerId], references: [id])

  cityId String?
  city   ServiceableCity? @relation(fields: [cityId], references: [id])

  status AdminInviteStatus @default(PENDING_OWNER_APPROVAL)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([invitedByOwnerId])
  @@index([status])
}

/// A rider's delivery profile (online status, vehicle, earnings). 1:1 with a
/// User whose role is RIDER. Riders claim PLATFORM_RIDER orders that are READY.
model RiderProfile {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  vehicle          String?
  /// The city this rider serves. Dispatch only offers a rider jobs from shops in
  /// the SAME city (pilot = Jhansi). Owner/admin-decided, like a shop's city.
  serviceCity      String                                 @default("Jhansi")
  online           Boolean                                @default(false)
  latitude         Decimal?                               @db.Decimal(9, 6)
  longitude        Decimal?                               @db.Decimal(9, 6)
  /// PostGIS geography(Point,4326), derived from longitude/latitude by the app on
  /// write (syncRiderGeog). GIST-indexed so rider-proximity checks (cart
  /// availability, go-online, order placement) never seq-scan. Declared
  /// Unsupported so Prisma leaves the out-of-band column + index alone.
  geog             Unsupported("geography(Point, 4326)")?
  earningsPaise    Int                                    @default(0) // accrued delivery earnings (paise)
  // Uncleared COD cash the rider has collected and owes onward. Blocks taking
  // new orders / going online once it hits the credit limit (admin clears it).
  duesPaise        Int                                    @default(0)
  creditLimitPaise Int                                    @default(50000) // ₹500 COD cap

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([online])
  @@index([serviceCity, online])
}

/// Rider KYC — identity + document details captured at registration so admin can
/// verify a delivery partner and pull their records if anything happens later.
/// Mirrors ShopKyc: sensitive numbers are stored (field-encrypt in prod) and the
/// document image URLs live in a private bucket (ADMIN-ONLY, never sent to other
/// roles). 1:1 with a rider's User.
model RiderKyc {
  id String @id @default(uuid())

  userId String @unique // 1:1 with the rider User
  user   User   @relation(fields: [userId], references: [id])

  fullName       String // legal name as on the ID
  aadhaar        String // Aadhaar number (field-encrypt in prod)
  pan            String? // PAN (optional for riders)
  dlNumber       String // driving licence number
  vehicleNumber  String? // vehicle registration plate
  emergencyName  String? // emergency contact name
  emergencyPhone String? // emergency contact phone
  photoUrl       String? // rider profile / face photo (private)
  docUrls        Json // ADMIN-ONLY: array of stored document image URLs (private bucket)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

/// A payment claim filed by a shopkeeper (dues) or rider (COD deposit) after
/// opening their UPI app. Admin verifies receipt and approves, which decrements
/// the balance by the exact claimed amount. Provides an audit trail so "Record
/// payment" is always tied to a specific claim rather than a blind zero-out.
model PaymentClaim {
  id          String    @id @default(uuid())
  /// 'SHOP' | 'RIDER'
  entityType  String
  shopId      String?
  riderUserId String?
  amountPaise Int
  /// 'PENDING' | 'APPROVED' | 'REJECTED'
  status      String    @default("PENDING")
  claimedAt   DateTime  @default(now())
  clearedAt   DateTime?
  clearedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([shopId])
  @@index([riderUserId])
}

/// Admin-created discount coupon with a unique code. Customers enter the code
/// at checkout; the server validates expiry, usage limits, and shop applicability.
model Coupon {
  id               String        @id @default(uuid())
  code             String        @unique
  type             String // PERCENT_OFF | FLAT_OFF | FREE_DELIVERY
  value            Int           @default(0) // percent points or paise
  description      String?
  minOrderPaise    Int           @default(0)
  maxDiscountPaise Int? // cap for PERCENT_OFF (paise); null = no cap
  maxUses          Int? // null = unlimited
  maxUsesPerUser   Int? // null = unlimited
  usedCount        Int           @default(0)
  validFrom        DateTime?
  expiresAt        DateTime?
  active           Boolean       @default(true)
  shopIds          String[] // empty = applicable to all shops
  cityIds          String[] // empty = all cities; non-empty = only these cities
  /// Who bears the discount: "SHOP" (default — deducted from the shop's earnings,
  /// like an offer) or "NEARBAZ" (platform-funded — NearBaz absorbs the discount
  /// as a marketing cost; the shop is never charged and its ledger is untouched).
  /// NEARBAZ coupons are city-targeted (cityIds) with no shop involvement.
  fundedBy         String        @default("SHOP") // SHOP | NEARBAZ
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  usages           CouponUsage[]

  @@index([active])
  @@index([code])
}

/// Tracks each time a coupon code was redeemed — for usage-limit enforcement.
model CouponUsage {
  id       String   @id @default(uuid())
  couponId String
  userId   String
  orderId  String
  usedAt   DateTime @default(now())
  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId, couponId])
}

/// Home-screen promo banner image, uploaded by admin and shown to customers as
/// an auto-scrolling carousel on the discovery/home screen. Targeted by city:
/// `cities` holds canonical city names (matching ServiceableCity.name /
/// Shop.city); an EMPTY array means the banner shows in ALL cities.
model Banner {
  id        String    @id @default(uuid())
  /// Public URL of the uploaded banner image.
  imageUrl  String
  /// Canonical city names this banner targets. Empty = all cities.
  cities    String[]
  /// Ascending display order within the carousel (lower shows first).
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([active])
}

/// NearBaz's OWN ledger — platform-level costs/subsidies that are NOT a shop's
/// dues and must never touch the shop-scoped LedgerEntry table. Today it records
/// COUPON_SUBSIDY entries: the discount NearBaz funded on a platform-funded
/// (fundedBy = NEARBAZ) coupon. This is NearBaz's marketing expense — a debit to
/// the platform P&L — so amountPaise is stored POSITIVE (money NearBaz gave away).
/// Lightweight audit table (mirrors AutomationLog): FK-like columns are plain
/// String? with indexes, no relations, so it never widens shop/order queries.
/// Never hard-deleted (deletedAt only) — losing a row = losing a cost record.
model PlatformLedgerEntry {
  id String @id @default(uuid())

  /// Short cost type. Today: "COUPON_SUBSIDY". Kept as a String (like Coupon.type)
  /// so new platform-cost kinds can be added without an enum migration.
  type String

  /// Optional links (audit only — no relations, mirrors AutomationLog).
  orderId  String?
  couponId String?
  cityId   String?
  userId   String? // the customer who redeemed the coupon

  /// Money, integer paise (rule #4). SIGNED: positive = cost NearBaz incurred
  /// (money given away); negative would be a reversal/credit back to NearBaz.
  amountPaise Int

  /// Snapshot of the coupon code for human-readable reporting.
  couponCode String?

  note String?

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([type])
  @@index([orderId])
  @@index([couponId])
  @@index([cityId])
  @@index([createdAt])
}

/// Every action taken automatically by the system (cron jobs). Displayed in the
/// admin taskboard under "Done by Automation" so admins have full visibility.
/// Can be reverted by an admin (revertedAt set); the revert undoes the side-effect.
model AutomationLog {
  id           String    @id @default(uuid())
  /// Short action type: ORDER_AUTO_CANCELLED | ORDER_REMIND | RIDER_EARNINGS_CREDITED
  /// | SHOP_AUTO_PAUSED | SHOP_AUTO_OPENED | SHOP_AUTO_CLOSED | DISPATCH_RE_OFFERED
  action       String
  /// Human-readable description of what was done
  detail       String
  /// Optional FK to the affected order (nullable)
  orderId      String?
  /// Optional FK to the affected shop (nullable)
  shopId       String?
  /// Optional FK to the affected rider user (nullable)
  riderUserId  String?
  /// Set when an admin reverts this action
  revertedAt   DateTime?
  revertedById String?
  revertNote   String?
  createdAt    DateTime  @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([shopId])
  @@index([orderId])
  @@index([revertedAt])
}

/// A help/dispute raised by a customer, shopkeeper, or rider on a specific order.
/// One per order (unique on orderId). Must be raised within DISPUTE_WINDOW_HOURS.
/// Status: OPEN → ASSIGNED (admin claims) → RESOLVED.
model OrderDispute {
  id              String           @id @default(uuid())
  orderId         String
  raisedById      String
  raisedByRole    String // CUSTOMER | SHOP | RIDER
  reason          String
  status          String           @default("OPEN") // OPEN | ASSIGNED | RESOLVED
  assignedAdminId String?
  assignedAt      DateTime?
  resolvedAt      DateTime?
  reopenCount     Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        DisputeMessage[]

  @@unique([orderId, raisedByRole])
  @@index([status])
  @@index([assignedAdminId])
}

/// A single message in a dispute thread (between the raiser and the assigned admin).
model DisputeMessage {
  id         String       @id @default(uuid())
  disputeId  String
  senderId   String
  senderRole String // CUSTOMER | SHOP | RIDER | ADMIN
  body       String
  createdAt  DateTime     @default(now())
  dispute    OrderDispute @relation(fields: [disputeId], references: [id], onDelete: Cascade)

  @@index([disputeId])
}

/// City-level offer template created by the owner. Shopkeepers in that city
/// can select one to run on their shop; the discount is auto-applied at checkout.
model OfferTemplate {
  id     String          @id @default(uuid())
  cityId String
  city   ServiceableCity @relation(fields: [cityId], references: [id])

  title         String // e.g. "10% OFF on all orders"
  type          OfferType
  /// For PERCENT_OFF: 1-100 (percent). For FLAT_OFF: paise (e.g. 2000 = ₹20).
  /// For FREE_DELIVERY: ignored (use 0).
  value         Int       @default(0)
  /// Minimum item subtotal (paise) required to activate this offer. 0 = always.
  minOrderPaise Int       @default(0)
  active        Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  shops Shop[] @relation("ShopActiveOffer")

  @@index([cityId])
  @@index([active])
}

// ===========================================================================
// SPONSORED ADS (CPC) — opt-in shop promotion, billed at day-end via ledger
// ===========================================================================

/// A shop's sponsored-ad campaign. Ads are OPT-IN: a shop enables promotion in
/// its app, which creates an ACTIVE campaign. Only ACTIVE campaigns pin the shop
/// to the top of discovery ("Sponsored" badge) and accrue CPC. Non-opted shops
/// rank on normal factors and are never charged. Admin sets the CPC price (per
/// city) and can view analytics / pause. Mirrors Coupon (budget/validity/active).
model AdCampaign {
  id     String @id @default(uuid())
  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  status AdCampaignStatus @default(ACTIVE)

  /// Cost-per-click in paise, snapshotted from the city's sponsoredCpcPaise at
  /// opt-in (admin can override per campaign). Billed once per unique daily click.
  cpcPaise         Int
  /// Total ad budget cap (paise). When spentPaise >= this, status → EXHAUSTED.
  totalBudgetPaise Int
  /// Shop-set daily spend cap (paise). 0 = no daily cap. When the day's billed
  /// spend reaches this, the ad auto-stops serving (dropped from sponsored slots)
  /// for the rest of the day; it auto-resumes the next day, or immediately if the
  /// shop raises this cap. Spend can never exceed it (enforced at click billing).
  dailyBudgetPaise Int       @default(0)
  /// Running billed spend (paise, GST-exclusive base). Incremented at day-end settle.
  spentPaise       Int       @default(0)
  /// Today's billed spend so far (paise, GST-exclusive). Enforces dailyBudgetPaise
  /// in real time; reset to 0 when dayResetAt rolls to a new day (at click time or
  /// day-end settle). Serving is gated on this vs dailyBudgetPaise.
  spentTodayPaise  Int       @default(0)
  /// The calendar day (midnight) that spentTodayPaise belongs to. When older than
  /// today, spentTodayPaise is stale (treated as 0) so the ad auto-resumes.
  dayResetAt       DateTime?

  /// Optional cities to restrict the promotion to (empty = shop's own city). Matches Coupon.cityIds.
  cityIds String[] @default([])

  startAt DateTime  @default(now())
  endAt   DateTime? // null = runs until budget exhausted / paused

  createdById String? // admin/owner or the shop owner who toggled it on
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  events AdEvent[]

  @@index([shopId])
  @@index([status])
}

/// A single ad interaction (impression or click) on a sponsored card. Clicks are
/// billed at day-end (CPC), once per (campaign, customer) per calendar day — the
/// first billable click of the day carries billedPaise = cpcPaise, repeats carry
/// 0. Impressions are never billed. This table is the analytics source (counts,
/// CTR, spend series) for the admin dashboard + the shopkeeper's own stats.
model AdEvent {
  id         String     @id @default(uuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id])
  shopId     String
  shop       Shop       @relation(fields: [shopId], references: [id])

  type       AdEventType
  customerId String? // the viewing/clicking customer (null for anonymous)
  customer   User?       @relation(fields: [customerId], references: [id])

  /// Amount this event will be billed at day-end (paise, GST-exclusive). Set to
  /// cpcPaise on the day's first billable click per customer; 0 otherwise.
  billedPaise Int       @default(0)
  /// Set when the day-end settle cron has folded this event into a ledger entry
  /// (so re-runs are idempotent). Null until settled.
  settledAt   DateTime?

  createdAt DateTime @default(now())

  @@index([campaignId])
  @@index([shopId])
  @@index([type])
  @@index([createdAt])
  @@index([campaignId, customerId, type])
}

// ===========================================================================
// PERSONALIZATION — per-customer taste profile (recomputed by cron)
// ===========================================================================

/// A per-customer taste profile derived from delivered-order history. Recomputed
/// periodically (recomputeCustomerProfiles cron); read at discovery to add a
/// personalization boost (category affinity + price-band match) on top of each
/// shop's precomputed rankScore. Never a source of truth — safe to recompute.
model CustomerProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  /// { "<shopCategory>": <weight 0..1>, ... } — recent-order affinity by category.
  categoryWeightsJson Json?
  /// Average order value (paise) — used for price-band matching.
  avgOrderValuePaise  Int   @default(0)
  /// Number of delivered orders considered when this profile was built.
  orderCount          Int   @default(0)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ===========================================================================
// PRESCRIPTIONS (medical-store-only order flow)
// ===========================================================================

/// A prescription upload from a customer to a medical shop. The customer uploads
/// Rx image(s); the shop reads them and builds a free-text itemized quote, which
/// becomes an Order (status QUOTE_PENDING → AWAITING_PAYMENT, UPI_DIRECT only).
/// Mirrors the BulkOrder envelope pattern (a separate table + Order.prescriptionId).
model Prescription {
  id      String  @id @default(uuid())
  /// Human-readable ID: RX + 8 hex.
  shortId String? @unique

  customerId String
  customer   User   @relation("PrescriptionCustomer", fields: [customerId], references: [id])

  shopId String
  shop   Shop   @relation(fields: [shopId], references: [id])

  /// Uploaded prescription image URLs (1+). Stored under uploads/prescription/.
  imageUrls String[]
  /// Optional free-text note from the customer (allergies, brand preference, etc.).
  note      String?

  status          PrescriptionStatus @default(SUBMITTED)
  /// Shop's reason when REJECTED (unreadable / out of stock / cannot fulfil).
  rejectionReason String?

  /// Customer's delivery choice, captured at upload. The shop (not the customer)
  /// triggers the quote that creates the Order, so it must be persisted here.
  deliveryMode DeliveryMode @default(SELF_PICKUP)
  addressId    String?
  address      Address?     @relation(fields: [addressId], references: [id])

  /// The Order created when the shop quotes (1:1). Null until QUOTED.
  order Order?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([shopId])
  @@index([status])
}
