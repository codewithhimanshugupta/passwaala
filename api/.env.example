# NearBaz API — environment variables (EXAMPLE / template only).
#
# SECURITY (Security & Data Protection rule): the real `.env` is git-ignored and
# secrets are NEVER committed. This `.env.example` holds only placeholders and
# safe local-dev defaults. Copy it to `.env` and fill in real values locally;
# in staging/prod these come from the host's secret manager, never from git.

# --- Database (local Docker Postgres + PostGIS — see docker-compose.yml) ---
DATABASE_URL="postgresql://nearbaz:dev@localhost:5432/nearbaz?schema=public"

# --- Redis (BullMQ job queue, cache, WebSocket fan-out) ---
REDIS_URL="redis://localhost:6379"

# --- Auth / JWT (short-lived access token + rotating refresh token) ---
# Generate strong random values locally; rotate the secrets in prod.
JWT_SECRET="change-me-dev-only-access-secret"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret"

# --- HTTP server ---
PORT=3000
# Comma-separated list of allowed CORS origins (locked down — never "*").
CORS_ORIGINS="http://localhost:3000,http://localhost:19006,http://localhost:8081"

# --- OTP / SMS (MSG91 Widget) ---
# Phone verification uses the MSG91 OTP Widget SDK in the apps (widget ID +
# token-auth are client-side constants in each app's src/msg91.ts). The API
# re-verifies the widget access token server-side via
# POST https://control.msg91.com/api/v5/widget/verifyAccessToken, which needs
# MSG91_AUTH_KEY. REQUIRED in production (NODE_ENV=production) — signup,
# verify-otp and reset-credentials all reject unverified tokens without it.
# In dev (NODE_ENV!=production) verification is bypassed, so this can stay empty.
# SENDER_ID / TEMPLATE_ID are unused by the widget flow (the widget sends the SMS).
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_OTP_TEMPLATE_ID=""

# --- Device push (Firebase Cloud Messaging) — placeholder ---
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- WhatsApp Cloud API (official) — placeholder, fallback behind FCM+SMS ---
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# AES-256 key (64 hex chars = 32 bytes) for encrypting backup login OTPs at rest.
# Generate: openssl rand -hex 32
AUTH_ENC_KEY=""
